msgstr "%s umbenannt"

#. translators: %s: number of categories removed.
#: includes/Admin/Settings.php:1248
#: includes/Admin/Settings.php:1250
#, php-format
msgid "%s removed"
msgstr "%s entfernt"

#. translators: %s: number of categories added.
#: includes/Admin/Settings.php:1254
#: includes/Admin/Settings.php:1256
#, php-format
